{
  "name": "pangolinfo-data-action",
  "version": "1.0.0",
  "private": true,
  "description": "Export Amazon and Google AI Overview data from Pangolinfo in GitHub Actions",
  "type": "module",
  "scripts": {
    "build": "ncc build src/index.js -o dist --minify --source-map",
    "check-dist": "git diff --exit-code -- dist/",
    "test": "node --test",
    "lint": "eslint .",
    "all": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
